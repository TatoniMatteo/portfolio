# Copia in ".env" accanto a docker-compose.yml (sul server).

# Fine-grained PAT con "Contents: Read-only" sul solo repo TatoniMatteo/CV.
# Resta sul server: non finisce mai in un'immagine né su GitHub.
CV_REPO_TOKEN=

# Porta sull'host (poi ci metti davanti il tuo reverse proxy / tunnel)
WEB_PORT=8080

# Ogni quante ore cercare un CV nuovo (default 24)
CV_CHECK_INTERVAL_HOURS=24

# "latest" oppure un tag preciso (es. sha-1a2b3c4) per tornare a una versione precedente
IMAGE_TAG=latest
