# Copia in ".env" accanto a docker-compose.yml (sul server).

# Consigliato: GitHub App installata sul solo repo TatoniMatteo/CV,
# con "Contents: Read-only". Token temporanei generati automaticamente.
# Client ID (o App ID); usa anche docker-compose.github-app.yml.
CV_APP_ID=
CV_APP_PRIVATE_KEY_PATH=./secrets/cv-app.pem
# Con GitHub App, abilita anche l'override su server Linux:
# COMPOSE_FILE=docker-compose.yml:docker-compose.github-app.yml

# Alternativa: fine-grained PAT con "Contents: Read-only" sul repo CV.
# Va sostituito manualmente alla scadenza; lascia vuoto se usi la App.
# Resta sul server: non finisce mai in un'immagine né su GitHub.
CV_REPO_TOKEN=

# Porta sull'host (poi ci metti davanti il tuo reverse proxy / tunnel)
WEB_PORT=8080

# Ogni quante ore cercare un CV nuovo (default 24)
CV_CHECK_INTERVAL_HOURS=24

# "latest" oppure un tag preciso (es. sha-1a2b3c4) per tornare a una versione precedente
IMAGE_TAG=latest
