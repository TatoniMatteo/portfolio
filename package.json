  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fetch-cv": "node scripts/cv/fetch-cv.mjs",
    "predev": "npm run fetch-cv",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
