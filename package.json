    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "pdfjs-dist": "^6.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.1.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
